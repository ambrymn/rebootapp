{
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo-go.ps1",
    "start:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo-go.ps1",
    "start:plain": "expo start --go --lan --port 0",
    "start:tunnel": "expo start --go --tunnel --port 0",
    "start:local": "expo start --go --localhost --port 0",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web"
  },
